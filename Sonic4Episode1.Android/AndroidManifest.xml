<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="Sonic4Episode1.Android.Sonic4Episode1.Android" android:versionCode="1" android:versionName="1.0">
	<!-- ASTC LDR is core in GLES 3.2 and an extension on 3.0/3.1, so 3.0 plus the extension is the
	     filter. The content tree is astc only, there is no BC fallback to drop to -->
	<uses-feature android:glEsVersion="0x00030000" android:required="true" />
	<supports-gl-texture android:name="GL_KHR_texture_compression_astc_ldr" />
	<application android:label="@string/app_name" android:icon="@drawable/icon"></application>
</manifest>