<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="1.0">
	<!-- no package attribute: it beats $(ApplicationId), and the one that was here was the template's
	     project name twice over, which is also what names the external files directory -->

	<!-- FNA3D takes the SDL_GPU driver and gets Vulkan, so this is a floor rather than the API the
	     game draws with. The texture filter that was here said astc, which stopped being true when
	     the head moved to the dxt set and the CPU decode behind it -->
	<uses-feature android:glEsVersion="0x00030000" android:required="true" />

	<uses-permission android:name="android.permission.INTERNET" />

	<!-- the content host is http on a LAN address while there is nothing to serve it properly -->
	<application android:label="@string/app_name" android:icon="@drawable/icon" android:usesCleartextTraffic="true"></application>
</manifest>
