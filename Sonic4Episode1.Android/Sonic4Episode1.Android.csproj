<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android37</TargetFramework>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.wamwoowam.Sonic4Episode1</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);TRACE;FNA;ASYNC_IO;AOT;SPLIT_LOOP;BGM_STREAM;</DefineConstants>
    <NoWarn>1701;1702;CA1416;CS0649;CS0169;CS0414;</NoWarn>
    <UseMonoRuntime>false</UseMonoRuntime>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <AndroidPackageFormat>apk</AndroidPackageFormat>    
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Submodules\FNA\FNA.Core.csproj" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
  
  <ItemGroup>
    <AndroidNativeLibrary Include="..\Dependencies\FNA\lib-android\arm64-v8a\libSDL3.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="..\Dependencies\FNA\lib-android\arm64-v8a\libFNA3D.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="..\Dependencies\FNA\lib-android\arm64-v8a\libFAudio.so" Abi="arm64-v8a" />
  </ItemGroup>
  
  <ItemGroup>
    <AndroidJavaSource Include="Java\**\*.java" Bind="true" />
    <TransformFile Include="Transforms\Metadata.xml" />
    <ProguardConfiguration Include="proguard.cfg" />
    <RdXmlFile Include="..\Sonic4Episode1\rd.xml" />
  </ItemGroup>
  
  <Import Project="..\Sonic4Episode1\Sonic4Episode1.projitems" Label="Shared" />
</Project>
