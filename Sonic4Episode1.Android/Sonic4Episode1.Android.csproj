<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36</TargetFramework>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.wamwoowam.Sonic4Episode1</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);TRACE;MONOGAME;THIRD_PARTY_DDS;ASYNC_IO;AOT;SPLIT_LOOP;BGM_MEDIAPLAYER;</DefineConstants>
    <NoWarn>1701;1702;CA1416;</NoWarn>
    <UseMonoRuntime>true</UseMonoRuntime>
    <!--<PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>-->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidBundleToolExtraArgs>--local-testing</AndroidBundleToolExtraArgs>
  </PropertyGroup>
  <!-- content comes from a built profile; see Content.targets and content-sources.toml -->
  <PropertyGroup>
    <ContentProfile>mobile-hd-astc</ContentProfile>
    <ContentItemType>AndroidAsset</ContentItemType>
  </PropertyGroup>
  <Import Project="..\Content.targets" />
  <Import Project="..\Shaders\Shaders.targets" />

  <ItemGroup>
    <PackageReference Include="DdsKtxXna.MonoGame" Version="0.4.4" />
    <!-- source, not the 3.8.x package: nothing published detects ASTC, so every .ast texture
         throws on load, see docs/monogame-mojoshader-ctab.md -->
    <ProjectReference Include="..\Submodules\MonoGame\MonoGame.Framework\MonoGame.Framework.Android.csproj" />
    <PackageReference Include="Xamarin.Google.Android.Play.Asset.Delivery" Version="2.3.0.5" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="all" />
    <PackageReference Include="Xamarin.AndroidX.Datastore.Preferences.Core.Jvm" Version="1.2.0.1" ExcludeAssets="all" />
  </ItemGroup>
  <Import Project="..\Sonic4Episode1\Sonic4Episode1.projitems" Label="Shared" />
</Project>