<Project>

  <!--
    Compiles Shaders\*.fx and copies the result next to the game as Content\Shaders\*.

    fxc emits a raw D3D9 effect. FNA's ContentManager resolves Content.Load<Effect>("Shaders\name")
    straight to a .fxb, effectExtensions in Submodules/FNA/src/Content/ContentManager.cs:98 lists it
    and the loader falls through to new Effect(device, data) at :362, so no .xnb wrapper is
    involved, and mppLoadStdShader reads its own blobs as a raw stream anyway.

    ContentItemType picks how the blobs are packaged and means the same thing it does in
    Content.targets.
  -->

  <PropertyGroup>
    <ShadersDir>$(MSBuildThisFileDirectory)</ShadersDir>
    <ShaderOutDir>$(ShadersDir)FNA\</ShaderOutDir>
    <ShaderExtension>.fxb</ShaderExtension>
    <!-- SM2 keeps us inside Reach; the effects are small enough to fit ps_2_0 -->
    <ShaderModel Condition="'$(ShaderModel)' == ''">SM2</ShaderModel>
  </PropertyGroup>

  <ItemGroup>
    <ShaderSource Include="$(ShadersDir)*.fx" />
  </ItemGroup>

  <!-- the NN standard shader is not built here, run Shaders/nn/Build-Permutations.ps1
       to produce its permutations into Shaders/FNA/nnstd/ -->

  <Target Name="LocateFxc">
    <ItemGroup>
      <FxcCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\fxc.exe" />
      <FxcCandidate Include="$(ProgramFiles)\Windows Kits\10\bin\*\x64\fxc.exe" />
    </ItemGroup>
    <PropertyGroup>
      <!-- item batching in a property takes the last match, i.e. the newest SDK -->
      <FxcPath>%(FxcCandidate.FullPath)</FxcPath>
    </PropertyGroup>
    <Message Condition="'$(FxcPath)' != ''" Importance="low" Text="Using fxc: $(FxcPath)" />
    <Warning Condition="'$(FxcPath)' == ''" Text="fxc.exe not found; shaders will not be rebuilt. Install the Windows SDK if you need to change them." />
  </Target>

  <!-- the condition belongs on the Exec, not the target: MSBuild evaluates a target's
       Condition before running DependsOnTargets, so gating here would skip the locate step -->
  <Target Name="CompileShaders"
          DependsOnTargets="LocateFxc"
          BeforeTargets="BeforeBuild"
          Inputs="@(ShaderSource);$(ShadersDir)Macros.fxh"
          Outputs="@(ShaderSource->'$(ShaderOutDir)%(Filename)$(ShaderExtension)')">
    <MakeDir Condition="'$(FxcPath)' != ''" Directories="$(ShaderOutDir)" />
    <Exec Condition="'$(FxcPath)' != ''"
          Command="&quot;$(FxcPath)&quot; /nologo /T fx_2_0 /D $(ShaderModel)=1 /Fo &quot;$(ShaderOutDir)%(ShaderSource.Filename).fxb&quot; &quot;%(ShaderSource.FullPath)&quot;" />
  </Target>

  <!-- globbed inside a target so a shader added this build has its .fxb by the time this runs.
       DependsOnTargets, not AfterTargets: both this and CompileShaders are pinned before
       AssignTargetPaths, and an AfterTargets edge between targets pinned to the same point
       doesn't hold, the glob ran first and missed the file -->
  <Target Name="CollectShaderContent"
          DependsOnTargets="CompileShaders"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ShaderBlob Include="$(ShaderOutDir)*$(ShaderExtension)" />
      <!-- one archive keyed by shader name, built by Shaders/nn/Build-Permutations.ps1 alongside
           the permutations themselves. Same path retail uses -->
      <NnStdShaderArchive Include="$(ShaderOutDir)NNSTDSHADER\SHADER.AMB" />

      <!-- metadata is qualified with the item name; a bare %(Filename) here batches over every
           existing Content item and drags unrelated files into Content\Shaders -->
      <Content Condition="'$(ContentItemType)' != 'AndroidAsset'"
               Include="@(ShaderBlob)"
               Link="Content\Shaders\%(ShaderBlob.Filename)%(ShaderBlob.Extension)"
               CopyToOutputDirectory="PreserveNewest" />
      <Content Condition="'$(ContentItemType)' != 'AndroidAsset'"
               Include="@(NnStdShaderArchive)"
               Link="Content\NNSTDSHADER\SHADER.AMB"
               CopyToOutputDirectory="PreserveNewest" />

      <!-- same asset pack as the content tree, not the base apk: DirectoryRoot.Root points at the
           pack, so anything outside it is not on a path AndroidTitleContainer can open. Nothing
           draws before the pack is there anyway, Sonic4Activity only calls Run() once it lands -->
      <AndroidAsset Condition="'$(ContentItemType)' == 'AndroidAsset'"
                    Include="@(ShaderBlob)"
                    Link="Assets\Content\Shaders\%(ShaderBlob.Filename)%(ShaderBlob.Extension)"
                    AssetPack="$(ContentAssetPack)"
                    DeliveryType="$(ContentAssetPackDelivery)" />
      <AndroidAsset Condition="'$(ContentItemType)' == 'AndroidAsset'"
                    Include="@(NnStdShaderArchive)"
                    Link="Assets\Content\NNSTDSHADER\SHADER.AMB"
                    AssetPack="$(ContentAssetPack)"
                    DeliveryType="$(ContentAssetPackDelivery)" />
    </ItemGroup>
  </Target>

</Project>
