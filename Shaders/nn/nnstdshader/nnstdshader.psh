      ( NND_OPT_TEXCOORD_DECAL2 == -1 ) || \
      ( NND_OPT_TEXCOORD_DECAL3 == -1 ) || \
      ( NND_OPT_TEXCOORD_SPECULAR == -1 ) || \
      ( NND_OPT_TEXCOORD_SHININESS == -1 ) || \
