      ( NND_OPT_TEXCOORD_USER5 == -1 ) || \
      ( NND_OPT_TEXCOORD_USER6 == -1 ) || \
      ( NND_OPT_TEXCOORD_USER7 == -1 ) || \
      ( NND_OPT_TEXCOORD_USER8 == -1 ) ) )
