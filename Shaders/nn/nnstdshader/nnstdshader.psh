/*------ Functions --------------------------------------------------------*/
//
float4 shadow2DProj(sampler2D s, float4 t)
{
#if 0
	float4 shadow;
	shadow = tex2Dproj( s, t );
	shadow = step(t.z/t.w, shadow.r);
	return(shadow);
#else
	float3 tp;
	float3 tx, ty;
	float2 lerps;
	//
	tp = t.xyz / t.w;
	//
#if 0 /* 2008.09.05 */
	lerps = frac(tp.xy);
#else
	/*
	  ドライバの不具合と思われる原因不明の現象が発生した為 frac 関数をコメントして
	  次のように変更して回避した。
	  不具合が発生したビデオカードは
	  ・Quadro FX 4500(ドライバ169.96)
	 */
	lerps = tp.xy - floor(tp.xy);
#endif
	//
	tx = ddx(tp);
	ty = ddy(tp);
	// [X, Y, Z] = [x, y][tx.x, tx.y, tx.z]
	//                   [ty.x, ty.y, ty.z]
	float3 ofs[3];
	// x=1, y=0
	ofs[0] = tx;
	// x=0, y=1
	ofs[1] = ty;
	// x=1, y=1
	ofs[2] = tx + ty;
	//
	float4 shadow[4], texDepth;
	// tp.x, tp.y
	texDepth  = tex2D( s, tp.xy );
	shadow[0] = step(tp.z, texDepth.r);
	// tp.x+1, tp.y
	texDepth  = tex2D( s, tp.xy+ofs[0].xy );
	shadow[1] = step(tp.z+ofs[0].z, texDepth.r);
	// tp.x, tp.y+1
	texDepth  = tex2D( s, tp.xy+ofs[1].xy );
	shadow[2] = step(tp.z+ofs[1].z, texDepth.r);
	// tp.x+1, tp.y+1
	texDepth  = tex2D( s, tp.xy+ofs[2].xy );
	shadow[3] = step(tp.z+ofs[2].z, texDepth.r);
	//
	float4 sha;
	// バイリニア補間
	sha = lerp(lerp(shadow[0], shadow[1], lerps.x),
			   lerp(shadow[2], shadow[3], lerps.x), lerps.y);
	// 平均
	//sha = (shadow[0] + shadow[1] + shadow[2] + shadow[3]) * 0.25;
	return(sha);
#endif
}

/* スフィアマップ */
#if ( NND_FRAG_SPHEREMAP )
float2 CalcSphereMapTexCoord( void )
{
	float3 r;
	float2 r2;
#if 0 /* 2008.06.06(バグ修正) */
	r = reflect( g_EyeDir, g_Normal );
#else
	r = reflect( g_EyeDir, g_FragNormal);
#endif
	r.z += 1.0;
	r2 = ( normalize(r).xy ) * float2(0.5, -0.5) + float2(0.5, 0.5);
	return(r2);
}
#endif

/* 双方物面マップ計算 */
#if ( NND_FRAG_DUALPARAMAP )
float2 CalcDualParaMapTexCoord( void )
{
	float3 r;
	float2 st;
	float s1, izi;

	/* 反射計算 */
	r = reflect( g_EyeDir, g_FragNormal );

	/* テクスチャマトリクスで変換（通常はワールド座標に変換） */
#if 0 /* 2008.06.04 */
	r = mul( r, u_TextureMatrix[ NND_OPT_TEX_DUALPARABOLOID ] );
#else
	r = mul( r, u_DualParaboloidMatrix );
#endif

	/* デュアルパラボロイド変換 */
	izi = 1.0 + abs( r.z );
	st = r.xy * float2( 1.0, -1.0 ) / izi;

	/* テクスチャの左右半分ずつに２枚並べる補正 */
	st = ( st + float2(1.0, 1.0) ) * 0.5;
	s1 = step( 0.0, r.z );
	st.x = ( 0.5 - s1 ) * st.x;
	return st;
}
#endif

/* 入力ベクトルを正規化します */
void NrmInput(void)
{
	#if ( NND_OPT_FRAG_LIGHTING || NND_FRAG_DUALPARAMAP )
	/* 視線方向 */
	g_EyeDir = normalize( g_Input.ViewPosFog.NND_SUFFIX_VPOS );
	#endif

	/* 接空間 */
	#if ( NND_OPT_FRAG_LIGHTING || NND_FRAG_DUALPARAMAP )
	g_Normal = normalize( g_Input.NrmVec );
		#if NND_OPT_TANGENT_SPACE
		g_Tangent = normalize( g_Input.Tan );
		g_Binormal = normalize( g_Input.BNrm );
		#endif
	#endif
}

/* テクスチャサンプリング */
void SampleTexMap(void)
{
	/* 法線マップ */
	#if ( NND_OPT_FRAG_LIGHTING || NND_FRAG_DUALPARAMAP )
		#if ( NND_OPT_TEX_NORMAL != -1 )
		g_smpNormal  = tex2D( s_texNormal, g_Input.UV[ NND_UV_NO_NORMAL ].NND_UV_SUFFIX_NORMAL );

		/* 法線取得 */
			#if NND_OPT_NORMALMAP_AXLY
			/* 圧縮タンジェントスペース法線マップの場合 */
			g_smpNormal = ( g_smpNormal - 0.5 ) * 2.0;
			float3 tannormal = float3( g_smpNormal.a, g_smpNormal.r, sqrt( 1.0 -
					( g_smpNormal.a*g_smpNormal.a + g_smpNormal.r*g_smpNormal.r ) ) );
			tannormal = normalize( tannormal );
			#else
			/* 通常の法線マップの場合 */
			float3 tannormal = normalize( g_smpNormal.rgb - 0.5 );
			#endif
			/* 法線をカメラ座標系に変換 */
			#if NND_OPT_TANGENT_SPACE
			g_FragNormal = tannormal.x * g_Tangent
								+ tannormal.y * g_Binormal
									+ tannormal.z * g_Normal;
			g_FragNormal = normalize( g_FragNormal );
			#else
			/* 本来はここは通らない */
			g_FragNormal = tannormal;
			#endif
		#else
		/* フラグメント単位ライティングの場合（法線マップなし） */
		g_FragNormal = g_Normal;
		#endif
	#endif

	/* 環境マップ用テクスチャ座標計算 */
	#if ( NND_FRAG_SPHEREMAP )
		g_SphereMapTexCoord = CalcSphereMapTexCoord();
	#endif
	#if ( NND_FRAG_DUALPARAMAP )
		g_DualParaMapTexCoord = CalcDualParaMapTexCoord();
	#endif

	/* 環境マスクマップ */
	#if ( NND_OPT_TEX_ENVMASK != -1 )
	g_smpEnvMask = tex2D( s_texEnvMask, g_Input.UV[ NND_UV_NO_ENVMASK ].NND_UV_SUFFIX_ENVMASK );
	#endif

	/* ベースディフューズマップ */
	#if ( NND_OPT_TEX_BASE != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_BASE == -1 )
		g_smpBase = tex2D( s_texBase, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_BASE == -3 )
		g_smpBase = tex2D( s_texBase, g_DualParaMapTexCoord );
		#else
		g_smpBase = tex2D( s_texBase, g_Input.UV[ NND_UV_NO_BASE ].NND_UV_SUFFIX_BASE );
		#endif
		#if ( ( NND_OPT_TEX_ENVMASK != -1 ) && ( ( NND_OPT_TEXCOORD_BASE == -1 ) || ( NND_OPT_TEXCOORD_BASE == -3 ) ) )
		g_smpBase = lerp( float4( 1.0, 1.0, 1.0, 1.0 ), g_smpBase, g_smpEnvMask.r );
		#endif

	/* ベースディフューズマップ不透明度 */
	g_smpBase.a *= u_TexBaseAlpha;
	#else
	/* ベーステクスチャがない場合はデフォルトのベース色を使用する */
	g_smpBase = float4( 1.0, 1.0, 1.0, 1.0 );
	#endif

	/* デカールマップ */
	#if ( NND_OPT_TEX_DECAL != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_DECAL == -1 )
		g_smpDecal = tex2D( s_texDecal, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_DECAL == -3 )
		g_smpDecal = tex2D( s_texDecal, g_DualParaMapTexCoord );
		#else
		g_smpDecal = tex2D( s_texDecal, g_Input.UV[ NND_UV_NO_DECAL ].NND_UV_SUFFIX_DECAL );
		#endif
	/* デカールマップ不透明度 */
	g_smpDecal.a *= u_TexDecalAlpha;
		#if ( ( NND_OPT_TEXCOORD_DECAL == -1 || NND_OPT_TEXCOORD_DECAL == -3 ) && NND_OPT_TEX_ENVMASK != -1 )
		g_smpDecal.a *= g_smpEnvMask.r;
		#endif
	#endif

	/* デカールマップ２ */
	#if ( NND_OPT_TEX_DECAL2 != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_DECAL2 == -1 )
		g_smpDecal2 = tex2D( s_texDecal2, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_DECAL2 == -3 )
		g_smpDecal2 = tex2D( s_texDecal2, g_DualParaMapTexCoord );
		#else
		g_smpDecal2 = tex2D( s_texDecal2, g_Input.UV[ NND_UV_NO_DECAL2 ].NND_UV_SUFFIX_DECAL2 );
		#endif
	/* デカールマップ２不透明度 */
	g_smpDecal2.a *= u_TexDecal2Alpha;
		#if ( ( NND_OPT_TEXCOORD_DECAL2 == -1 || NND_OPT_TEXCOORD_DECAL2 == -3 ) && NND_OPT_TEX_ENVMASK != -1 )
		g_smpDecal2.a *= g_smpEnvMask.r;
		#endif
	#endif

	/* デカールマップ３ */
	#if ( NND_OPT_TEX_DECAL3 != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_DECAL3 == -1 )
		g_smpDecal3 = tex2D( s_texDecal3, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_DECAL3 == -3 )
		g_smpDecal3 = tex2D( s_texDecal3, g_DualParaMapTexCoord );
		#else
		g_smpDecal3 = tex2D( s_texDecal3, g_Input.UV[ NND_UV_NO_DECAL3 ].NND_UV_SUFFIX_DECAL3 );
		#endif
	/* デカールマップ３不透明度 */
	g_smpDecal3.a *= u_TexDecal3Alpha;
		#if ( ( NND_OPT_TEXCOORD_DECAL3 == -1 || NND_OPT_TEXCOORD_DECAL3 == -1 ) && NND_OPT_TEX_ENVMASK != -1 )
		g_smpDecal3.a *= g_smpEnvMask.r;
		#endif
	#endif

	/* スペキュラマップ */
	#if ( NND_OPT_TEX_SPECULAR != -1 )
		g_smpSpecular = tex2D( s_texSpecular, g_Input.UV[ NND_UV_NO_SPECULAR ].NND_UV_SUFFIX_SPECULAR );
	#endif

	/* スペキュラ光沢度マップ */
	#if ( NND_OPT_TEX_SHININESS != -1 )
		g_smpShininess = tex2D( s_texShininess, g_Input.UV[ NND_UV_NO_SHININESS ].NND_UV_SUFFIX_SHININESS );
	#endif
	
	/* 乗算テクスチャ */
	#if ( NND_OPT_TEX_MODULATE != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_MODULATE == -1 )
		g_smpModulate = tex2D( s_texModulate, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_MODULATE == -3 )
		g_smpModulate = tex2D( s_texModulate, g_DualParaMapTexCoord );
		#else
		g_smpModulate = tex2D( s_texModulate, g_Input.UV[ NND_UV_NO_MODULATE ].NND_UV_SUFFIX_MODULATE );
		#endif
		/* 環境マスクマップ適用 */
		#if ( NND_OPT_TEX_ENVMASK != -1 && ( NND_OPT_TEXCOORD_MODULATE == -1 || NND_OPT_TEXCOORD_MODULATE == -3 ) )
			g_smpModulate = float4( 1.0, 1.0, 1.0, 1.0 )
				- ( float4( 1.0, 1.0, 1.0, 1.0 ) - g_smpModulate ) * g_smpEnvMask.r;
		#endif
	#endif

	/* 加算テクスチャ */
	#if ( NND_OPT_TEX_ADD != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_ADD == -1 )
		g_smpAdd = tex2D( s_texAdd, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_ADD == -3 )
		g_smpAdd = tex2D( s_texAdd, g_DualParaMapTexCoord );
		#else
		g_smpAdd = tex2D( s_texAdd, g_Input.UV[ NND_UV_NO_ADD ].NND_UV_SUFFIX_ADD );
		#endif
		/* 加算マップ強度 */
		g_smpAdd *= u_TexAddLevel;
		/* 環境マスクマップ適用 */
		#if ( NND_OPT_TEX_ENVMASK != -1 && ( NND_OPT_TEXCOORD_ADD == -1 || NND_OPT_TEXCOORD_ADD == -3 ) )
		g_smpAdd *= g_smpEnvMask.r;
		#endif
	#endif

	/* 双方物面環境マップ */
	#if ( NND_OPT_TEX_DUALPARABOLOID != -1 )
	g_smpDualParaboloid = tex2D( s_texDualParaboloid, g_DualParaMapTexCoord );
		#if ( NND_OPT_TEX_ENVMASK != -1 )
		g_smpDualParaboloid *= g_smpEnvMask.r;
		#endif
	/* 双方物面環境マップ強度 */
	g_smpDualParaboloid *= u_TexDualParaboloidLevel;
	#endif

	/* シャドウマップテクスチャ */
	#if ( NND_OPT_TEX_SHADOW != -1 )
		g_smpShadow = shadow2DProj(s_texShadow, g_Input.TexShadow);
	#endif

	/* シャドウマップ２テクスチャ */
	#if ( NND_OPT_TEX_SHADOW2 != -1 )
		g_smpShadow2 = shadow2DProj(s_texShadow2, g_Input.TexShadow2);
	#endif

	/* 不透明度テクスチャ */
	#if ( NND_OPT_TEX_OPACITY != -1 )
		#if ( NND_FRAG_SPHEREMAP && NND_OPT_TEXCOORD_OPACITY == -1 )
		g_smpOpacity = tex2D( s_texOpacity, g_SphereMapTexCoord );
		#elif ( NND_OPT_TEXCOORD_OPACITY == -3 )
		g_smpOpacity = tex2D( s_texOpacity, g_DualParaMapTexCoord );
		#else
		g_smpOpacity = tex2D( s_texOpacity, g_Input.UV[ NND_UV_NO_OPACITY ].NND_UV_SUFFIX_OPACITY );
		#endif
		/* 環境マスクマップ適用 */
		#if ( NND_OPT_TEX_ENVMASK != -1 && ( NND_OPT_TEXCOORD_OPACITY == -1 || NND_OPT_TEXCOORD_OPACITY == -3 ) )
		g_smpOpacity *= ( 1.0 - g_smpEnvMask.r );
		#endif
	#endif

	/* ベースおよびデカール貼り */
	#if ( NND_OPT_TEX_DECAL3 != -1 )
	g_FragColor = lerp( lerp( lerp( g_smpBase.rgb, g_smpDecal.rgb, g_smpDecal.a ),
					g_smpDecal2.rgb, g_smpDecal2.a ), g_smpDecal3.rgb, g_smpDecal3.a );
	#elif ( NND_OPT_TEX_DECAL2 != -1 )
	g_FragColor = lerp( lerp( g_smpBase.rgb, g_smpDecal.rgb, g_smpDecal.a ),
												g_smpDecal2.rgb, g_smpDecal2.a );
	#elif ( NND_OPT_TEX_DECAL != -1 )
	g_FragColor = lerp( g_smpBase.rgb, g_smpDecal.rgb, g_smpDecal.a );
	#else
	g_FragColor = g_smpBase.rgb;
	#endif
}

/* ライト計算 */
void CalcLight(void)
{
	#if !( NND_OPT_TWOSIDED_LIGHTING )
		g_VtxDiffCol = g_Input.FrontCol[0];
		#if NND_OPT_SPECULAR
			g_VtxSpecCol = g_Input.FrontCol[1];
		#endif
	#else
		/* DirextX は右回りが表として処理されますが、
		   DXG20 は左回りを表としているので、
		   vFace は逆の意味になります */
		g_VtxDiffCol = ( g_Input.vFace < 0.0 ? g_Input.FrontCol[0] : g_Input.BackCol[0] );
		#if NND_OPT_SPECULAR
			g_VtxSpecCol = ( g_Input.vFace < 0.0 ? g_Input.FrontCol[1] : g_Input.BackCol[1] );
		#endif
	#endif

	#if NND_OPT_FRAG_LIGHTING && NND_OPT_LIGHTING
	/* フラグメント単位ライティング */

		#if ( NND_OPT_NUM_FRAG_PARALLEL_LIGHT > 0 )
		/* パラレルライトの計算 */
		for ( int litno = 0;
					litno < NND_OPT_NUM_FRAG_PARALLEL_LIGHT; litno++ ){
			float3 litdir = u_LightSource[ litno ].position.xyz;
			/* ディフューズ計算 */
			float fdiff = dot ( g_FragNormal, litdir );
			//fdiff = max( fdiff, 0.0 );
			fdiff = clamp( fdiff, 0.0, 1.0 );
			g_FragDiffuse += fdiff * u_LightSource[ litno ].diffuse.rgb;
			/* スペキュラ計算 */
			#if NND_OPT_SPECULAR
			float3 halfvec = normalize(	litdir - g_EyeDir );
			g_FragSpecular += u_LightSource[ litno ].specular.rgb *
					pow(    abs(
							//max( dot( halfvec, g_FragNormal ), 0.0 ),
							clamp( dot( halfvec, g_FragNormal ), 0.0, 1.0 ) ),
							#if ( NND_OPT_TEX_SHININESS != -1 )
								u_TexShininessLevel * g_smpShininess.r
								* u_FrontMaterial.shininess
							#else
								u_FrontMaterial.shininess
							#endif
					);
			#endif
			#if ( NND_PROF_LIGHT_AMBIENT )
			/* アンビエント */
			g_FragAmbient += u_LightSource[litno].ambient.rgb;
			#endif
		}
		#endif

		#if ( NND_OPT_NUM_FRAG_POINT_LIGHT > 0 )
		{
		/* ポイントライトの計算 */
		for ( int litno = NND_OPT_NUM_FRAG_PARALLEL_LIGHT;
				litno < NND_OPT_NUM_FRAG_PARALLEL_LIGHT
									+ NND_OPT_NUM_FRAG_POINT_LIGHT; litno ++ )
		{
			float diffcnt, speccnt, dist, attn;
			float3 litpos, litdir;
			int unino;

			/* ライト位置 */
			litpos = u_LightSource[ litno ].position.xyz - g_Input.ViewPosFog.NND_SUFFIX_VPOS;

			/* 減衰度 */
			dist = length( litpos );
			#if ( NND_PROF_POINTLIGHT_DISTATTEN == 0 )
			/* 減衰なし */
			attn = 1.0;
			#endif
			#if ( NND_PROF_POINTLIGHT_DISTATTEN == 1 )
			/* 逆 */
			attn = 1.0 / dist;
			#endif
			#if ( NND_PROF_POINTLIGHT_DISTATTEN == 2 )
			/* 逆２乗 */
			attn = 1.0 / ( dist * dist );
			#endif
			/* フォールオフ */
			unino = litno - NND_OPT_NUM_FRAG_PARALLEL_LIGHT;
			attn *= clamp(
					( u_PointLightFallOffEnd[ unino ] - dist )
						* u_PointLightFallOffScale[ unino ], 0.0, 1.0 );

			/* ライト方向 */
			litdir = normalize( litpos );

			/* ディフューズ成分 */
			//diffcnt = max( dot( g_FragNormal, litdir ), 0.0 );
			diffcnt = clamp( dot( g_FragNormal, litdir ), 0.0, 1.0 );
			g_FragDiffuse += u_LightSource[litno].diffuse.rgb * diffcnt * attn;

			/* スペキュラ計算 */
			#if NND_OPT_SPECULAR
			float3 halfvec = normalize( litdir - g_EyeDir );
			g_FragSpecular += u_LightSource[ litno ].specular.rgb *
					pow(    abs(
							//max( dot( halfvec, g_FragNormal ), 0.0 ),
							clamp( dot( halfvec, g_FragNormal ), 0.0, 1.0 ) ),
							#if ( NND_OPT_TEX_SHININESS != -1 )
								u_TexShininessLevel * g_smpShininess.r
												* u_FrontMaterial.shininess
							#else
								u_FrontMaterial.shininess
							#endif
					) * attn;
			#endif
			#if ( NND_PROF_LIGHT_AMBIENT )
			/* アンビエント */
			g_FragAmbient += u_LightSource[litno].ambient.rgb * attn;
			#endif
		}
		}
		#endif

		/* ディフューズ、アンビエント、エミッション成分 */
		#if ( NND_OPT_TEX_SHADOW != -1 )
			/* シャドウマップの場合 */
			float3 shadowcolor = max( g_smpShadow.rgb, u_TexShadowColor.rgb );

			#if ( NND_OPT_TEX_SHADOW2 != -1 )
				/* シャドウマップ２がある場合 */
				shadowcolor *= max( g_smpShadow2.rgb, u_TexShadow2Color.rgb );
			#endif
			#if ( NND_PROF_LIGHT_AMBIENT )
				g_FragColor *= ( g_FragDiffuse * g_VtxDiffCol.rgb * shadowcolor
								+ u_FrontLightModelProduct.sceneColor.rgb
								+ g_FragAmbient.rgb );

			#else
				g_FragColor *= ( g_FragDiffuse * g_VtxDiffCol.rgb * shadowcolor
								+ u_FrontLightModelProduct.sceneColor.rgb );
			#endif
		#else
			#if ( NND_PROF_LIGHT_AMBIENT )
				g_FragColor *= ( g_FragDiffuse * g_VtxDiffCol.rgb
			 					+ u_FrontLightModelProduct.sceneColor.rgb
								+ g_FragAmbient.rgb );
			#else
				g_FragColor *= ( g_FragDiffuse * g_VtxDiffCol.rgb
			 					+ u_FrontLightModelProduct.sceneColor.rgb );
			#endif
		#endif

		/* スペキュラ成分 */
		#if ( NND_OPT_TEX_SPECULAR != -1 )
		/* スペキュラマップ */
		g_FragSpecular *= g_smpSpecular.rgb;
		#endif
		#if ( NND_OPT_TEX_SHADOW != -1 )
			/* シャドウマップの場合 */
			#if NND_OPT_SPECULAR
				g_FragColor += g_FragSpecular * shadowcolor
							* g_VtxSpecCol.rgb * u_FrontMaterial.specular.rgb;
			#else
				g_FragColor += g_FragSpecular * shadowcolor
					       * u_FrontMaterial.specular.rgb;
			#endif
		#else
			#if NND_OPT_SPECULAR
				g_FragColor += g_FragSpecular
							* g_VtxSpecCol.rgb * u_FrontMaterial.specular.rgb;
			#else
				g_FragColor += g_FragSpecular * u_FrontMaterial.specular.rgb;
			#endif
		#endif

	#else
	
	/* 頂点単位ライティング */
	/* ディフューズ */
		#if ( NND_OPT_TEX_SHADOW != -1 )
		/* シャドウマップの場合 */
		float3 shadowcolor = max( g_smpShadow.rgb, u_TexShadowColor.rgb );
		#if ( NND_OPT_TEX_SHADOW2 != -1 )
			/* シャドウマップ２がある場合 */
			shadowcolor *= max( g_smpShadow2.rgb, u_TexShadow2Color.rgb );
		#endif
		g_FragColor *= g_VtxDiffCol.rgb * shadowcolor;
		#else
		g_FragColor *= g_VtxDiffCol.rgb;
		#endif
	/* スペキュラ */
		#if ( NND_OPT_TEX_SPECULAR != -1 )
		/* スペキュラマップ */
			#if ( NND_OPT_TEX_SHADOW != -1 )
			/* シャドウマップの場合 */
			g_FragColor += g_smpSpecular.rgb * shadowcolor
					* g_VtxSpecCol.rgb * u_FrontMaterial.specular.rgb;
			#else
			g_FragColor += g_smpSpecular.rgb
					* g_VtxSpecCol.rgb * u_FrontMaterial.specular.rgb;
			#endif
		#else
			#if ( NND_OPT_TEX_SHADOW != -1 )
			/* シャドウマップの場合 */
			g_FragColor += g_VtxSpecCol.rgb * shadowcolor
								* u_FrontMaterial.specular.rgb;
			#else
			g_FragColor += g_VtxSpecCol.rgb
								* u_FrontMaterial.specular.rgb;
			#endif
		#endif
		
	#endif
}

/* テクスチャフィルターを掛けます */
void BlendTexFilter(void)
{
	/* 乗算テクスチャ */
	#if ( NND_OPT_TEX_MODULATE != -1 )
	g_FragColor *= g_smpModulate.rgb;
	#endif

	/* 加算テクスチャ */
	#if ( NND_OPT_TEX_ADD != -1 )
	g_FragColor += g_smpAdd.rgb;
	#endif

	/* 双方物面環境マップテクスチャ */
	#if ( NND_OPT_TEX_DUALPARABOLOID != -1 )
	g_FragColor += g_smpDualParaboloid.rgb;
	#endif
}

/* アルファ値の算出 */
void CalcAlpha(void)
{
	/* ベーステクスチャ */
	#if ( NND_OPT_TEX_DECAL3 != -1 )
	g_FragAlpha = 1.0 - (1.0-g_smpBase.a) * (1.0-g_smpDecal.a) 
							* (1.0-g_smpDecal2.a) * (1.0-g_smpDecal3.a);
	#elif ( NND_OPT_TEX_DECAL2 != -1 )
	g_FragAlpha = 1.0 -
					(1.0-g_smpBase.a) * (1.0-g_smpDecal.a) * (1.0-g_smpDecal2.a);
	#elif ( NND_OPT_TEX_DECAL != -1 )
	g_FragAlpha = g_smpBase.a + g_smpDecal.a - g_smpBase.a * g_smpDecal.a;
	#else
	g_FragAlpha = g_smpBase.a;
	#endif
	/* 不透明度テクスチャ */
	#if ( NND_OPT_TEX_OPACITY != -1 )
	g_FragAlpha *= g_smpOpacity.r;
	#endif
	/* 乗算テクスチャアルファ */
	#if ( NND_OPT_TEX_MODULATE != -1 )
	g_FragAlpha *= g_smpModulate.a;
	#endif
	/* 頂点カラーおよびマテリアルのアルファ */
	g_FragAlpha *= g_VtxDiffCol.a;

	/* カラークランプ */
	g_FragColor = clamp( g_FragColor, 0.0, 1.0 );
}

/* フォッグ計算 */
void CalcFog(void)
{
	/* 頂点フォグ */
	#if ( !( NND_PROF_FRAG_FOG ) && ( NND_PROF_FOG_MODEL ) )
		g_FragColor = lerp( u_Fog.color.rgb, g_FragColor , g_Input.ViewPosFog.NND_SUFFIX_FOG );
	#endif

	/* フラグメント単位フォグ */
	#if ( NND_PROF_FRAG_FOG && NND_PROF_FOG_MODEL )
		float fogd;
		#if ( NND_PROF_FOG_MODEL == 1 )
			fogd = ( u_Fog.end - g_Input.ViewPosFog.NND_SUFFIX_FOG ) * u_Fog.scale;
		#elif ( NND_PROF_FOG_MODEL == 2 )
			fogd = exp2( -u_Fog.density * g_Input.ViewPosFog.NND_SUFFIX_FOG * 1.442695 );
		#elif ( NND_PROF_FOG_MODEL == 3 )
			fogd = exp2( -u_Fog.density * u_Fog.density
							* g_Input.ViewPosFog.NND_SUFFIX_FOG * g_Input.ViewPosFog.NND_SUFFIX_FOG * 1.442695 );
		#endif
		fogd = clamp( fogd, 0.0, 1.0 );
		g_FragColor = lerp( u_Fog.color.rgb, g_FragColor, fogd );
	#endif
}

/* 最終出力カラーの設定 */
void SetFinalColor(void)
{
	g_Output.Col.rgb = g_FragColor;		// フラグメントカラー出力
	g_Output.Col.a   = g_FragAlpha;		// フラグメントアルファ出力
}

/**************************/
/* ピクセルシェーダメイン */
/**************************/
PS_OUTPUT main(PS_INPUT Input)
{
	g_Input = Input;

	NrmInput();				// 入力ベクトルを正規化します	
	SampleTexMap();			// テクスチャサンプリング
	CalcLight();			// ライト計算
	BlendTexFilter();		// テクスチャフィルターを掛けます
	CalcAlpha();			// アルファ値の算出
	CalcFog();				// フォッグ計算
	SetFinalColor();		// 最終出力カラーの設定
	return( g_Output );
}

/*-------------------------------------------------------------------------*/
