    ( ( NND_OPT_TEXCOORD_ADD == -3 ) || \
      ( NND_OPT_TEXCOORD_BASE == -3 ) || \
      ( NND_OPT_TEXCOORD_DECAL == -3 ) || \
      ( NND_OPT_TEXCOORD_DECAL2 == -3 ) || \
